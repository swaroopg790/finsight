# FinSight — Local Dev Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit it.
#
# Usage: run start-backend.ps1 (reads this file automatically)
# ─────────────────────────────────────────────────────────────────────────────

# ── Plaid ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com → Team Settings → Keys
# Use the Sandbox credentials (not Development or Production)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here

# Set to "sandbox" to use real Plaid Link widget (user_good / pass_good)
# Set to "mock"    to use synthetic data with no Plaid credentials needed
PLAID_MODE=sandbox

# ── Polygon.io (optional — used for real market prices / benchmark data) ─────
# Free tier at https://polygon.io → 5 calls/min, prev-day close only
# Leave blank to use built-in mock data (fine for development)
POLYGON_API_KEY=

# ── JWT / Encryption (dev defaults are set in application.yml) ───────────────
# Override here only if you want stronger secrets in your local env
# FINSIGHT_JWT_SECRET=your-secret-at-least-32-characters-long
# FINSIGHT_ENCRYPTION_KEY=your-aes-256-encryption-key-here

# ── Mail (dev mode logs to console by default — no SMTP needed) ──────────────
# FINSIGHT_MAIL_DEV=true
